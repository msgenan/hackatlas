{
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable slug: <name-slug>-<year>",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "organizer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organizer"
        },
        "url": {
          "description": "Official page or application link",
          "title": "Url",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "One or two sentences in our own words",
          "title": "Summary"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "online",
                "in_person",
                "hybrid"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Location"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "starts_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Starts On"
        },
        "ends_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ends On"
        },
        "deadline": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Last day to apply",
          "title": "Deadline"
        },
        "prize": {
          "anyOf": [
            {
              "$ref": "#/$defs/Prize"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "team": {
          "anyOf": [
            {
              "$ref": "#/$defs/Team"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "eligibility": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Who can join, e.g. 'Lisans öğrencileri, 18-30 yaş'",
          "title": "Eligibility"
        },
        "themes": {
          "items": {
            "type": "string"
          },
          "title": "Themes",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceRef"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only for LLM-extracted records",
          "title": "Confidence"
        },
        "added_at": {
          "format": "date-time",
          "title": "Added At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "url",
        "sources",
        "added_at",
        "updated_at"
      ],
      "title": "Event",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 3166-1 alpha-2, upper case (TR, US)",
          "title": "Country"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "Prize": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total prize pool as a number, if stated",
          "title": "Amount"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 4217 (USD, TRY, EUR)",
          "title": "Currency"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short wording as announced, e.g. '50.000 TL + staj'",
          "title": "Text"
        }
      },
      "title": "Prize",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "devpost",
            "mlh",
            "devfolio",
            "techcareer",
            "web",
            "instagram",
            "manual"
          ],
          "title": "Kind",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "seen_at": {
          "format": "date-time",
          "title": "Seen At",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url",
        "seen_at"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "Team": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        }
      },
      "title": "Team",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Shape of data/events.json and data/pending.json.",
  "properties": {
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "title": "EventFile",
  "type": "object"
}
