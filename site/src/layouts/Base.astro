---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/chart.css";
import "../styles/list.css";
import "../styles/pages.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { href } from "../lib/url";
import { iconSprite } from "../lib/icons";

interface Props {
  title?: string;
  description?: string;
  current?: "harita" | "takvim" | "rota" | "";
  noindex?: boolean;
}
const { title, description = "Türkiye ve dünyadan hackathonlar bir deniz haritasında: son başvuru, tarih, yer, ödül ve takım bilgisi tek düzende.", current = "", noindex = false } = Astro.props;
const full = title ? `${title} - hackatlas` : "hackatlas - hackathon haritası";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="hackatlas" href={href("feed.xml")} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      /* Stored theme before first paint; ?theme=dark|light forces one without storing it (screenshots only).
         Iris: when a hackathon was opened from the chart or the list, the new page opens as a circle from that spot. */
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        try {
          var q = new URLSearchParams(location.search).get("theme");
          var t = q === "dark" || q === "light" ? q : localStorage.getItem("hackatlas:theme");
          if (t === "dark" || t === "light") d.setAttribute("data-theme", t);
        } catch (e) {}
        addEventListener("pagereveal", function (e) {
          var vt = e.viewTransition;
          if (vt) { vt.ready.catch(function () {}); vt.finished.catch(function () {}); }
          var at = null;
          try {
            at = JSON.parse(sessionStorage.getItem("hackatlas:iris") || "null");
            sessionStorage.removeItem("hackatlas:iris");
          } catch (err) {}
          if (!vt || !at) return;
          d.style.setProperty("--ix", at.x + "%");
          d.style.setProperty("--iy", at.y + "%");
          d.classList.add("iris");
          vt.finished.finally(function () { d.classList.remove("iris"); }).catch(function () {});
        });
      })();
    </script>
  </head>
  <body>
    <Fragment set:html={iconSprite()} />
    <a class="skip" href="#main">İçeriğe geç</a>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/common";
    </script>
  </body>
</html>
