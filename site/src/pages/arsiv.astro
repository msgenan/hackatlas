---
import Base from "../layouts/Base.astro";
import Entry from "../components/Entry.astro";
import { site } from "../lib/site";
const { ended } = site();
---
<Base title="Arşiv" description="Bitmiş hackathonlar, en yeniden eskiye.">
  <section class="page">
    <header class="page-head">
      <h1 class="page-title">Arşiv</h1>
      <p class="lead">Bitmiş hackathonlar, en yeniden eskiye. Haritadan kalkan adalar burada kalır.</p>
    </header>
    {ended.length === 0 ? (
      <p class="lead na">Henüz biten bir hackathon yok.</p>
    ) : (
      <ol class="entries">{ended.map((v) => <Entry v={v} ended locate={false} />)}</ol>
    )}
  </section>
</Base>
