---
import Base from "../layouts/Base.astro";
import Engraving from "../components/Engraving.astro";
import { href } from "../lib/url";
---
<Base title="Sayfa bulunamadı" noindex>
  <section class="page lost">
    <Engraving name="serpent" class="lost-art" />
    <h1 class="page-title">Bu koordinatta kara yok.</h1>
    <p class="lead">Aradığın sayfa taşınmış ya da hiç var olmamış olabilir. Hackathon bittiyse arşivde bulabilirsin.</p>
    <p class="lost-act"><a class="btn-primary" href={href()}>Haritaya dön</a><a class="btn-ghost" href={href("arsiv/")}>Arşive bak</a></p>
  </section>
</Base>
