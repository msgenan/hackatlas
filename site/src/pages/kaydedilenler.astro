---
import Base from "../layouts/Base.astro";
import Entry from "../components/Entry.astro";
import Engraving from "../components/Engraving.astro";
import { site } from "../lib/site";
import { href } from "../lib/url";

const { upcoming, ended } = site();
const all = [...upcoming, ...ended];
---
<Base title="Rotam" current="rota" description="Rotana eklediğin hackathonlar, bu tarayıcıda saklanır." noindex>
  <section class="page route-page" data-route-page>
    <header class="page-head">
      <h1 class="page-title">Rotam</h1>
      <p class="lead" data-route-lead>Rotana eklediğin hackathonlar son başvuru sırasıyla. Liste bu tarayıcıda saklanır.</p>
    </header>
    <div class="route-empty" data-route-empty hidden>
      <Engraving name="ship" class="route-art" />
      <p class="none-title">Rotan henüz boş.</p>
      <p class="none-text">Haritada ya da listede bir hackathonun yanındaki yer imi simgesine bas, rotana eklensin. Haritada magenta bir rota çizgisiyle görünür.</p>
      <p><a class="btn-primary" href={href()}>Haritaya git</a></p>
    </div>
    <p class="route-nostorage" data-route-nostorage hidden>Bu tarayıcıda yerel depolama kapalı olduğu için rota tutulamıyor.</p>
    <ol class="entries" data-route-list>
      {all.map((v) => <Entry v={v} hidden={true} ended={v.group === "ended"} locate={false} />)}
    </ol>
  </section>
  <script>
    import "../scripts/route-page";
  </script>
</Base>
