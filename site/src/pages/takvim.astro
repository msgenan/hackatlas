---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { site } from "../lib/site";
import { MONTHS, WEEKDAYS_SHORT, monthCells, parts } from "../lib/dates";
import { href } from "../lib/url";
import { DEFAULT_FILTERS, matches } from "../lib/filters";

const { today, upcoming } = site();
const t = parts(today);
type Mark = { id: string; name: string; kind: "deadline" | "start"; on: boolean };
const marks = new Map<string, Mark[]>();
const add = (d: string, m: Mark) => marks.set(d, [...(marks.get(d) ?? []), m]);
for (const v of upcoming) {
  const on = matches(v.meta, DEFAULT_FILTERS);
  if (v.e.deadline && v.e.deadline >= today) add(v.e.deadline, { id: v.e.id, name: v.e.name, kind: "deadline", on });
  if (v.e.starts_on && v.e.starts_on >= today) add(v.e.starts_on, { id: v.e.id, name: v.e.name, kind: "start", on });
}
const last = [...marks.keys()].sort().at(-1) ?? today;
const months: { y: number; m: number }[] = [];
for (let y = t.y, m = t.m; months.length < 8; m === 12 ? (y++, (m = 1)) : m++) {
  months.push({ y, m });
  const lp = parts(last);
  if (y > lp.y || (y === lp.y && m >= lp.m)) break;
}
const metaIds = Object.fromEntries(upcoming.map((v) => [v.e.id, v.meta]));
---
<Base title="Takvim" current="takvim" description="Hackathonların son başvuru ve başlangıç günleri, ay ay.">
  <section class="page cal-page" data-cal>
    <header class="page-head">
      <h1 class="page-title">Takvim</h1>
      <p class="lead">Fener işareti son başvuru gününü, düz çizgi hackathonun başladığı günü gösterir.</p>
    </header>
    <div class="cal-bar">
      <div class="cal-nav">
        <button type="button" class="scrub-btn" data-cal-step="-1" aria-label="Önceki ay"><Icon name="chevron-left" size={18} /></button>
        <p class="cal-month" data-cal-label aria-live="polite">{MONTHS[t.m - 1]} {t.y}</p>
        <button type="button" class="scrub-btn" data-cal-step="1" aria-label="Sonraki ay"><Icon name="chevron-right" size={18} /></button>
      </div>
      <fieldset class="f-seg" data-cal-region>
        <legend class="sr-only">Bölge</legend>
        <label><input type="radio" name="bolge" value="katilabilir" checked /><span>Katılabileceklerim</span></label>
        <label><input type="radio" name="bolge" value="tumu" /><span>Tümü</span></label>
      </fieldset>
    </div>
    {months.map(({ y, m }, i) => (
      <section class="cal-month-block" data-month={i} aria-label={`${MONTHS[m - 1]} ${y}`}>
        <h2 class="cal-h">{MONTHS[m - 1]} {y}</h2>
        <div class="cal-grid">
          {WEEKDAYS_SHORT.map((d) => <p class="cal-wd" aria-hidden="true">{d}</p>)}
          {monthCells(y, m).map((d) => {
            const p = parts(d);
            const out = p.m !== m;
            const list = out ? [] : (marks.get(d) ?? []);
            return (
              <div class:list={["cal-day", out && "out", d === today && "today", d < today && "past", list.length > 0 && "has"]} data-day={d}>
                <p class="cal-d"><span class="cal-d-n">{p.d}</span><span class="cal-d-w">{MONTHS[p.m - 1]}</span></p>
                {list.length > 0 && (
                  <ul>
                    {list.map((mk) => (
                      <li class={`ce ce-${mk.kind}`} data-id={mk.id} data-pre={mk.on ? undefined : "out"}>
                        <a href={href(`e/${mk.id}/`)} data-iris>
                          <span class="ce-mark" aria-hidden="true"></span>
                          <span class="sr-only">{mk.kind === "deadline" ? "Son başvuru: " : "Başlıyor: "}</span>
                          <span class="ce-name">{mk.name}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            );
          })}
        </div>
      </section>
    ))}
  </section>
  <script type="application/json" id="hackatlas-data" set:html={JSON.stringify(metaIds).replace(/</g, "\\u003c")} />
  <script>
    import "../scripts/calendar";
  </script>
</Base>
