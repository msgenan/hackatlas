---
import Base from "../layouts/Base.astro";
import Chart from "../components/Chart.astro";
import Entry from "../components/Entry.astro";
import Filters from "../components/Filters.astro";
import Engraving from "../components/Engraving.astro";
import Icon from "../components/Icon.astro";
import { site, defaultVisible } from "../lib/site";
import { GROUP_LABELS, GROUP_ORDER, type Group } from "../lib/countdown";
import { ISSUE_NEW } from "../lib/format";

const { today, upcoming, updated } = site();
const first = new Set(defaultVisible(upcoming).map((v) => v.e.id));
const byGroup = (g: Group) => upcoming.filter((v) => v.group === g);
const metas = upcoming.map((v) => v.meta);
const GROUP_NOTES: Partial<Record<Group, string>> = {
  week: "Fener yanan adalar. Başvuru 7 gün içinde kapanıyor.",
  unknown: "Tarihi henüz açıklanmamış hackathonlar.",
  closed: "Başvurusu kapanmış ama henüz bitmemiş hackathonlar.",
};
---
<Base current="harita">
  {upcoming.length === 0 ? (
    <section class="page empty-sea">
      <Engraving name="serpent" class="empty-art" />
      <h1 class="page-title">Haritada henüz ada yok.</h1>
      <p class="lead">Yeni hackathonlar gözden geçirildikten sonra burada görünür. Bildiğin bir hackathon varsa ekleyebilirsin.</p>
      <p><a class="btn-primary" href={ISSUE_NEW} target="_blank" rel="noopener"><Icon name="plus" />Hackathon ekle</a></p>
    </section>
  ) : (
    <>
      <Chart views={upcoming} today={today} updated={updated} firstIds={first} />
      <section class="gazetteer" id="liste" aria-labelledby="dizin-title">
        <div class="gz-head">
          <h2 id="dizin-title" class="gz-title">Dizin</h2>
          <p class="gz-sub">Haritadaki her ada, hep aynı sırayla: son başvuru, tarih, yer, ödül, takım.</p>
        </div>
        <Filters />
        <div class="groups" data-groups>
          {GROUP_ORDER.map((g) => {
            const items = byGroup(g);
            const rows = (
              <ol class="entries" data-rows={g}>
                {items.map((v) => <Entry v={v} pre={!first.has(v.e.id)} />)}
              </ol>
            );
            return g === "closed" ? (
              <details class="group" data-group={g} hidden={items.length === 0}>
                <summary class="group-head"><Icon name="chevron-right" /><span class="group-name">{GROUP_LABELS[g]}</span><span class="group-n" data-gcount>{items.length}</span></summary>
                {GROUP_NOTES[g] && <p class="group-note">{GROUP_NOTES[g]}</p>}
                {rows}
              </details>
            ) : (
              <section class="group" data-group={g} hidden={items.length === 0}>
                <h3 class="group-head"><span class="group-name">{GROUP_LABELS[g]}</span><span class="group-n" data-gcount>{items.length}</span></h3>
                {GROUP_NOTES[g] && <p class="group-note">{GROUP_NOTES[g]}</p>}
                {rows}
              </section>
            );
          })}
          <section class="group" data-group="flat" hidden>
            <h3 class="group-head"><span class="group-name" data-flat-name>Sıralı liste</span><span class="group-n" data-gcount>0</span></h3>
            <ol class="entries" data-rows="flat"></ol>
          </section>
        </div>
        <div class="none-found" data-none hidden>
          <Engraving name="serpent" class="none-art" />
          <p class="none-title">Bu sularda eşleşen hackathon yok.</p>
          <p class="none-text">Aramayı kısalt ya da bir filtreyi kaldır.</p>
          <button type="button" class="btn-primary" data-clear>Filtreleri temizle</button>
        </div>
      </section>
      <script type="application/json" id="hackatlas-data" set:html={JSON.stringify(metas).replace(/</g, "\\u003c")} />
      <script type="application/json" id="hackatlas-first" set:html={JSON.stringify([...first])} />
      <script>
        import "../scripts/home";
      </script>
    </>
  )}
</Base>
