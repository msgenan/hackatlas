---
import Icon from "./Icon.astro";
const opts = [["system", "Sistem", "monitor"], ["light", "Gündüz haritası", "sun"], ["dark", "Gece haritası", "moon"]] as const;
---
<div class="theme" role="radiogroup" aria-label="Görünüm">
  {opts.map(([v, l, i]) => <button type="button" role="radio" aria-checked={v === "system" ? "true" : "false"} data-theme-set={v} title={l} aria-label={l}><Icon name={i} size={16} /></button>)}
</div>
