---
import { THEMES } from "../lib/types";
import { themeName } from "../lib/format";
import Icon from "./Icon.astro";
const regions = [["katilabilir", "Katılabileceklerim"], ["tr", "Türkiye"], ["tumu", "Tümü"]] as const;
const formats = [["online", "Online"], ["in_person", "Yüz yüze"], ["hybrid", "Hibrit"]] as const;
const sorts = [["son-basvuru", "Son başvuru"], ["odul", "Ödül"], ["tarih", "Başlangıç"], ["yeni", "Yeni eklenen"]] as const;
---
<form class="filters" data-filters role="search" aria-label="Hackathonları süz" onsubmit="return false">
  <div class="f-row">
    <label class="f-search">
      <Icon name="search" size={18} />
      <span class="sr-only">Ara</span>
      <input type="search" name="q" placeholder="Ad, organizatör, şehir ya da konu" autocomplete="off" />
    </label>
    <fieldset class="f-seg">
      <legend class="sr-only">Bölge</legend>
      {regions.map(([v, l]) => <label><input type="radio" name="bolge" value={v} checked={v === "katilabilir"} /><span>{l}</span></label>)}
    </fieldset>
    <label class="f-sort">
      <span>Sırala</span>
      <select name="sirala">{sorts.map(([v, l]) => <option value={v}>{l}</option>)}</select>
    </label>
  </div>
  <div class="f-row f-chips">
    <fieldset class="f-group">
      <legend class="sr-only">Biçim</legend>
      {formats.map(([v, l]) => <label class="chip"><input type="checkbox" name="format" value={v} /><span>{l}</span></label>)}
      <label class="chip"><input type="checkbox" name="odul" value="1" /><span>Ödüllü</span></label>
    </fieldset>
    <fieldset class="f-group f-themes">
      <legend class="sr-only">Konu</legend>
      {THEMES.map((t) => <label class="chip"><input type="checkbox" name="konu" value={t} /><span>{themeName(t)}</span></label>)}
    </fieldset>
  </div>
  <div class="f-status">
    <p class="f-count" data-count aria-live="polite"></p>
    <button type="button" class="link-btn" data-clear hidden><Icon name="x" size={14} />Filtreleri temizle</button>
  </div>
</form>
