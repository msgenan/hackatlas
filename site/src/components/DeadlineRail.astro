---
import { railHtml, railSignature, type RailItem } from "../lib/rail";
interface Props { items: RailItem[]; today: string }
const { items, today } = Astro.props;
---
<section class="rail" aria-labelledby="rail-title" data-enter>
  <h2 id="rail-title" class="sr-only">Önümüzdeki 8 haftada kapanan başvurular</h2>
  <div class="rail-scroll" tabindex="-1">
    <div class="rail-track" role="group" data-sig={railSignature(items, today)} aria-label="Son başvuru çizelgesi" set:html={railHtml(items, today, true)} />
  </div>
  <div class="rail-tip" role="tooltip" id="rail-tip" aria-hidden="true"></div>
</section>
