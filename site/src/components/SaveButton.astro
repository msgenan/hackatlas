---
import Icon from "./Icon.astro";
interface Props { id: string; full?: boolean }
const { id, full = false } = Astro.props;
---
<button type="button" class:list={["save", full && "save-full"]} data-save={id} aria-pressed="false" title={full ? undefined : "Rotaya ekle"} aria-label={full ? undefined : "Rotaya ekle"}>
  <span class="save-off"><Icon name="bookmark" size={full ? 16 : 18} /></span>
  <span class="save-on"><Icon name="bookmark-check" size={full ? 16 : 18} /></span>
  {full && <span class="save-text"><span class="save-off">Rotaya ekle</span><span class="save-on">Rotada</span></span>}
</button>
